# ══════════════════════════════════════════════════════════════════════
# Crew Configuration - Parallel Agent Orchestration
# ══════════════════════════════════════════════════════════════════════
# Copy to .crew/crew.yaml in your project.
# Env vars (${VAR}) are expanded from .crew/.env at runtime.
#
# ── Fallback Chain ──
# Each agent runs at "level 0" (primary) first.
# When max_restarts is exhausted at one level, the next fallback level
# takes over. Each level can change the CLI type, env vars, or both.
#
#   Level 0 (primary)  →  fails 5 times
#   Level 1 (fallback) →  fails 3 times
#   Level 2 (fallback) →  fails 3 times
#   ... all exhausted  →  agent stops (.crew/run/<name>.exhausted)
#
# ── Env Overlay ──
# Fallback-level env vars are MERGED on top of agent-level env.
# Only override what changes; the rest is inherited.
#
# ── CLI Types ──
# Built-in plugins: claude, codex, codex_legacy, opencode, gemini, aider
# codex_legacy uses Codex v0.80.0 (supports wire_api=chat for 3rd party models)
# Custom plugins:   .crew/cli.d/<name>.sh or ~/.crew/cli.d/<name>.sh
# Legacy escape:    command: ./your-script.sh (runs via eval)
#
# ── Supported Fields per Agent ──
# name           Required. Unique ID ([A-Za-z0-9_-], max 32 chars)
# icon           Optional. Emoji for status display
# type           CLI plugin name (default: claude)
# prompt         Path to prompt file (relative to .crew/)
# interval       Seconds between runs (default: 10)
# timeout        Kill if no output for N seconds (default: 600)
# max_restarts   Retries before moving to next fallback level (default: 5)
# env            Per-agent environment variables
# fallback       Array of fallback levels (label, type, env, max_restarts)
# ══════════════════════════════════════════════════════════════════════

project: my-project
log_dir: .crew/logs
check_interval: 30  # Health check interval (seconds)

# ── Progress Watchdog ──────────────────────────────────────────────
# Monitors agents for stuck/idle behavior using heuristics + optional
# AI judge. The watchdog runs lightweight Bash checks at check_interval;
# if an agent shows no progress for idle_timeout, it's flagged SUSPECT.
#
# When ai_judge is enabled, a one-shot LLM call (rate-limited to 1/hour
# per agent) reviews logs and renders a STUCK/PRODUCTIVE/UNCERTAIN verdict.
# When disabled, SUSPECT triggers on_stuck directly.
#
# on_stuck actions:
#   fallback  — advance to next fallback level (writes .advance marker)
#   restart   — kill and restart the agent at current level
#   notify    — run on_stuck_command (e.g. Slack/SMS alert)
#   stop      — stop the agent entirely
# ───────────────────────────────────────────────────────────────────
watchdog:
  enabled: false               # Set true to activate progress monitoring
  check_interval: 900          # 15min between lightweight Bash checks
  idle_timeout: 1800           # 30min no progress → SUSPECT
  on_stuck: fallback           # Action: fallback | restart | notify | stop
  # on_stuck_command: ./scripts/alert.sh  # Required when on_stuck: notify

  ai_judge:
    enabled: false             # Opt-in; adds LLM cost per stuck event
    type: claude               # CLI plugin for the judge call
    prompt: prompts/crew/watchdog.md
    env:
      ANTHROPIC_MODEL: claude-haiku-4-5-20251001  # Use cheapest model

agents:

  # ────────────────────────────────────────────────────────────────────
  # USE CASE 1: Same CLI, Model Degradation
  # ────────────────────────────────────────────────────────────────────
  # Strategy: Stay on claude CLI but step down through cheaper models.
  #   opus (best quality) → sonnet (balanced) → 3rd party (cheapest)
  #
  # When to use: You want the best model first, but can tolerate
  # lower quality if the premium API is down or rate-limited.
  # ────────────────────────────────────────────────────────────────────
  - name: QA
    icon: 🔴
    type: claude
    prompt: prompts/qa.txt
    interval: 10
    timeout: 600
    max_restarts: 5

    # Primary: Claude CLI with Opus (premium model)
    env:
      ANTHROPIC_MODEL: claude-opus-4-20250514
      ANTHROPIC_API_KEY: ${ANT_API_KEY}

    fallback:
      # Fallback 1: Same CLI, cheaper model (Sonnet)
      # Only override ANTHROPIC_MODEL; API key is inherited from agent env.
      - label: sonnet-fallback
        type: claude
        max_restarts: 3
        env:
          ANTHROPIC_MODEL: claude-sonnet-4-20250514

      # Fallback 2: Same CLI, 3rd party Anthropic-compatible provider
      # Override the full endpoint to route through a different provider.
      - label: openrouter-fallback
        type: claude
        max_restarts: 3
        env:
          ANTHROPIC_BASE_URL: ${OPENROUTER_ANT_URL}
          ANTHROPIC_MODEL: ${OPENROUTER_ANT_MODEL}
          ANTHROPIC_API_KEY: ${OPENROUTER_ANT_KEY}

  # ────────────────────────────────────────────────────────────────────
  # USE CASE 2: Cross-CLI Tool Fallback
  # ────────────────────────────────────────────────────────────────────
  # Strategy: Cascade through entirely different CLI tools.
  #   claude → codex → gemini → local LLM (via codex)
  #
  # When to use: You want maximum resilience. If one vendor's API
  # is down, try another vendor's tool. Last resort: self-hosted LLM
  # with zero API cost and no network dependency.
  # ────────────────────────────────────────────────────────────────────
  - name: DEV
    icon: 🔵
    type: claude
    prompt: prompts/dev.txt
    interval: 10
    timeout: 600
    max_restarts: 5

    # Primary: Claude CLI (Anthropic)
    env:
      ANTHROPIC_API_KEY: ${ANT_API_KEY}

    fallback:
      # Fallback 1: Switch to Codex CLI (OpenAI)
      # Completely different CLI tool and provider.
      - label: codex-openai
        type: codex
        max_restarts: 3
        env:
          OPENAI_API_KEY: ${OPENAI_API_KEY}

      # Fallback 2: Switch to Gemini CLI (Google)
      # GEMINI_API_KEY should be set in .crew/.env
      - label: gemini-google
        type: gemini
        max_restarts: 3

      # Fallback 3: Local LLM via Codex Legacy (v0.80.0, supports wire_api=chat)
      # Use codex_legacy for OpenAI-compatible local servers (Ollama, LMStudio, etc.)
      # Install: npm install -g @openai/codex@0.80.0 --prefix ~/.codex-legacy
      #          ln -sf ~/.codex-legacy/bin/codex ~/.local/bin/codex-legacy
      - label: local-llm
        type: codex_legacy
        max_restarts: 3
        env:
          CODEX_MODEL: ${LOCAL_OAI_MODEL}
          CODEX_PROVIDER: local
          CODEX_BASE_URL: ${LOCAL_OAI_URL}
          CODEX_WIRE_API: chat
          OPENAI_API_KEY: ${LOCAL_OAI_KEY}

  # ────────────────────────────────────────────────────────────────────
  # USE CASE 3: Mixed Strategy with Script Fallback
  # ────────────────────────────────────────────────────────────────────
  # Strategy: Try AI tools first, then fall back to a custom script.
  #   claude → opencode → ./scripts/notify.sh
  #
  # When to use: For non-critical tasks where you'd rather send a
  # notification (SMS, Slack, email) than let the agent die silently.
  # The script fallback is also useful for:
  #   - Triggering CI/CD pipelines
  #   - Running pre-built automation (linting, formatting)
  #   - Posting to monitoring dashboards
  #   - Any shell command as a last resort
  # ────────────────────────────────────────────────────────────────────
  - name: JANITOR
    icon: 🟢
    type: claude
    prompt: prompts/janitor.txt
    interval: 1800     # 30 minutes - lightweight maintenance task
    timeout: 600
    max_restarts: 5

    # Primary: Claude CLI
    env:
      ANTHROPIC_API_KEY: ${ANT_API_KEY}

    fallback:
      # Fallback 1: Switch to OpenCode CLI
      # OpenCode supports various models via its own config.
      - label: opencode-backup
        type: opencode
        max_restarts: 3
        env:
          OPENCODE_MODEL: ${OPENCODE_MODEL}

      # Fallback 2: Custom script - notify the team
      # When ALL AI tools fail, run a shell script instead.
      # The script receives the prompt file via stdin, same as CLI plugins.
      # Example uses:
      #   - Send SMS/Slack alert: "JANITOR agent exhausted all AI fallbacks"
      #   - Run a simpler non-AI cleanup script
      #   - Post to PagerDuty / Opsgenie
      - label: notify-team
        command: ./scripts/notify.sh
        max_restarts: 1
