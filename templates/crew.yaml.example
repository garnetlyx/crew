# Crew Configuration - Parallel Agents
# Copy to .crew/crew.yaml in your project

project: my-project
log_dir: .crew/logs
check_interval: 30  # Health check interval (seconds)

agents:
  - name: QA
    icon: 🔴
    type: claude                # CLI type: claude, codex, opencode, gemini, aider
    prompt: prompts/qa.txt
    interval: 10       # Seconds between runs
    timeout: 600       # Kill if no output for this long (10 minutes)
    max_restarts: 5
    working_dirs:      # Advisory: only modify files in these dirs
      - docs/
      - e2e/
      - server/src/__tests__/
    env:
      ANTHROPIC_BASE_URL: ${1ST_BASE_URL}
      ANTHROPIC_MODEL: ${1ST_MODEL}
      ANTHROPIC_API_KEY: ${1ST_API_KEY}
    # Model fallback chain (tried in order when max_restarts exhausted):
    # All entries go under ONE fallback key — do NOT repeat the key.
    # Example Strategy: Switch models/providers while keeping type: claude
    fallback:
      - label: third_party_1
        type: claude
        max_restarts: 3
        env:
          ANTHROPIC_BASE_URL: https://api.deepseek.com/v1
          ANTHROPIC_MODEL: deepseek-coder
          ANTHROPIC_API_KEY: ${DEEPSEEK_API_KEY}
      - label: third_party_2
        type: claude
        max_restarts: 3
        env:
          ANTHROPIC_BASE_URL: https://api.together.xyz/v1
          ANTHROPIC_MODEL: meta-llama/Llama-3-70b-chat-hf
          ANTHROPIC_API_KEY: ${TOGETHER_API_KEY}

  - name: DEV
    icon: 🔵
    type: codex                # CLI type: codex
    prompt: prompts/dev.txt
    interval: 10
    timeout: 600
    max_restarts: 5
    working_dirs:
      - server/src/
      - client/src/
    # Example Strategy: Switch underlying tool CLI entirely
    fallback:
      - label: use-gemini
        type: gemini
        max_restarts: 3
      - label: use-opencode
        type: opencode
        max_restarts: 3


  - name: JANITOR
    icon: 🟢
    type: claude                # CLI type: claude
    prompt: prompts/janitor.txt
    interval: 1800     # 30 minutes
    timeout: 600
    max_restarts: 5
    working_dirs:
      - docs/
      - "*.md"
      - "*screenshot*"
    # Example Strategy: Mix tool/model changes and custom shell scripts
    fallback:
      - label: opencode-custom
        type: opencode
        max_restarts: 3
        env:
          OPENCODE_MODEL: zen/big-pickle
      - label: emergency-script
        command: ./scripts/emergency-cleanup.sh
        max_restarts: 3

